<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- The engine lives in the plugin; the spike compiles the same source files. -->
  <ItemGroup>
    <Compile Include="..\..\plugins\TypeWhisper.Plugin.ParakeetOpenVino\Engine\**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\plugins\TypeWhisper.Plugin.ParakeetOpenVino\Engine\**\*.bin" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
