<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <RootNamespace>TypeWhisper.Plugin.ParakeetOpenVino</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1574;CS1581;CS1584</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TypeWhisper.PluginSDK\TypeWhisper.PluginSDK.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Engine\*.bin" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Copies the plugin next to the locally built app. Pass -p:InstallPlugin=true to also install
       it into %LOCALAPPDATA%\TypeWhisper\Plugins (the running TypeWhisper's plugin folder). -->
  <Target Name="CopyToAppPlugins" AfterTargets="Build">
    <PropertyGroup>
      <AppOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\src\TypeWhisper.Windows\bin\$(Configuration)\$(TargetFramework)'))</AppOutputDir>
      <PluginOutputDir>$(AppOutputDir)\Plugins\com.whispernpu.parakeet-openvino\</PluginOutputDir>
      <LocalAppPluginDir>$(LOCALAPPDATA)\TypeWhisper\Plugins\com.whispernpu.parakeet-openvino\</LocalAppPluginDir>
      <InstallPluginLocally Condition="'$(InstallPlugin)' == 'true' and '$(LOCALAPPDATA)' != ''">true</InstallPluginLocally>
    </PropertyGroup>
    <ItemGroup>
      <_PluginFiles Include="$(TargetPath);$(ProjectDir)manifest.json" />
      <_PluginFiles Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    </ItemGroup>
    <MakeDir Directories="$(PluginOutputDir)" />
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(PluginOutputDir)" />
    <MakeDir Directories="$(LocalAppPluginDir)" Condition="'$(InstallPluginLocally)' == 'true'" />
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(LocalAppPluginDir)" Condition="'$(InstallPluginLocally)' == 'true'" />
  </Target>
</Project>
